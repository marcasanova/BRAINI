# Copia este fichero a `.env` y rellena los valores de tu proyecto Supabase.
# Nunca commits `.env`, `.env.local` ni `.env.test`.

# URL del proyecto (pública en el cliente; no es un secreto)
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co

# Clave anon / publishable (pública en el cliente; la protección es RLS)
VITE_SUPABASE_ANON_KEY=tu_clave_anon
